  {
    "name": "quote_create_draft",
    "title": "견적 초안 만들기",
    "description": "딜에 표준 템플릿 견적 초안(draft, 버전 1)을 만든다. 공급자(SW=클래스인/HW=퀴드러닝)·합계는 어드민 작성기와 같은 계산이다. 공유 링크·발송·승인은 하지 않는다 — 어드민 견적 탭에서 열어 옵션·담당자를 고친 뒤 사람이 보낸다. 줄을 안 주면 템플릿 기본 수량·단가를 쓴다(quote_templates 로 먼저 본다).",
    "inputSchema": {
      "type": "object",
      "properties": {
        "deal_id": {
          "type": "string",
          "format": "uuid",
          "description": "deals_list 의 id"
        },
        "template_id": {
          "type": "string",
          "enum": [
            "camera_t1",
            "board_75",
            "board_86",
            "recording_studio",
            "recording_studio_75",
            "business_recharge"
          ]
        },
        "lines": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "properties": {
              "line_number": {
                "type": "integer",
                "minimum": 1
              },
              "quantity": {
                "type": "integer",
                "minimum": 0
              },
              "unit_price": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "line_number"
            ],
            "additionalProperties": false
          }
        },
        "valid_until": {
          "type": "string",
          "format": "date",
          "description": "YYYY-MM-DD"
        },
        "internal_memo": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "deal_id",
        "template_id"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "견적 초안 만들기",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  },
  {
    "name": "hw_plan_movement",
    "title": "HW 배송 예정 등록",
    "description": "창고에서 고객에게 나갈 출고를 '배송 예정'으로 등록한다(가용에서 미리 빠진다, 창고 재고는 그대로). 실제 출고 확정·입고·조정은 하지 않는다 — 어드민 HW 화면에서 사람이 확정한다.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "item_id": {
          "type": "string",
          "description": "hw_stock 의 itemId(있으면 품목을 정확히 고른다)"
        },
        "product_name": {
          "type": "string",
          "description": "품목 이름(hw_stock 의 product)"
        },
        "quantity": {
          "type": "integer",
          "minimum": 1
        },
        "planned_date": {
          "type": "string",
          "format": "date",
          "description": "배송 예정일 YYYY-MM-DD"
        },
        "customer": {
          "type": "string",
          "description": "받는 곳(학원·고객명)"
        },
        "outbound_type": {
          "type": "string",
          "enum": [
            "sales",
            "promotion",
            "as",
            "sample"
          ],
          "default": "sales",
          "description": "sales(세일즈)·promotion·as·sample"
        },
        "reference_no": {
          "type": "string",
          "description": "주문·계약 번호(중복 등록을 막는 데 쓰인다)"
        },
        "lot_no": {
          "type": "string",
          "description": "물류 번호"
        },
        "memo": {
          "type": "string",
          "maxLength": 500
        }
      },
      "required": [
        "product_name",
        "quantity",
        "planned_date",
        "customer"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "title": "HW 배송 예정 등록",
      "readOnlyHint": false,
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": false
    }
  }
