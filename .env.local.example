# ============================================================
# Classin Home example environment variables
# Copy this file to .env.local and fill in the real values.
# ============================================================

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# Blog data source
USE_SUPABASE_BLOG=true
USE_SUPABASE_LEADS=true
USE_SUPABASE_MARKETING=true

# Legacy admin auth fallback
# role: "admin" = full access
# role: "branch" = branch-scoped access
ADMIN_USERS=[{"name":"홍길동","password":"your-admin-pw","role":"admin"},{"name":"부산지사장","password":"your-branch-pw","role":"branch","branch":"부산지사"}]
# ADMIN_PASSWORD=your-admin-password
SESSION_SECRET=replace-with-a-long-random-server-only-secret
SECURITY_TOKEN_SECRET=replace-with-a-long-random-server-only-secret
PAGE_WEBHOOK_SECRET=replace-with-a-long-random-shared-secret

# Existing webhook integrations
GOOGLE_SHEET_WEBHOOK_URL=
LEAD_WEBHOOK_URL=
CHANNEL_TALK_WEBHOOK_URL=
EMAIL_WEBHOOK_URL=

# Meta Marketing / Lead Ads / Conversions API
# Server-only secrets: do not prefix these with NEXT_PUBLIC_.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_API_VERSION=v25.0
META_BUSINESS_ID=
META_AD_ACCOUNT_ID=act_
# Marketing API token. If omitted, server routes can fall back to META_CAPI_ACCESS_TOKEN
# when that token is a System User token with ads_read/ads_management.
META_ACCESS_TOKEN=
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
# Optional direct IG Business/Creator account ID for Instagram post insights.
# If omitted, the admin API tries META_PAGE_ID -> instagram_business_account, then the ad account's instagram_accounts edge.
META_INSTAGRAM_BUSINESS_ACCOUNT_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_KAKAO_PIXEL_ID=
NEXT_PUBLIC_INTERNAL_TRACKING_ENABLED=true

# 쿠키 동의 (옵트인 + Consent Mode v2) — 정책이 바뀌면 값을 올려 재동의 유도
NEXT_PUBLIC_CONSENT_POLICY_VERSION=2026-06-14

# Channel Talk web messenger (client SDK)
# 챗봇이 문제 해결/컴플레인 핸드오프 시 띄우는 라이브 채팅 위젯
NEXT_PUBLIC_CHANNEL_PLUGIN_KEY=

# AI integrations
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro
GEMINI_FAST_MODEL=gemini-2.5-flash

# Google Service Account (Sheets / Calendar / Gmail — see lib/google.ts)
# Extract these two fields from the service account JSON key file:
#   client_email  → GOOGLE_SERVICE_ACCOUNT_EMAIL
#   private_key   → GOOGLE_PRIVATE_KEY  (wrap in double quotes; leave \n escapes intact)
# NEVER commit the JSON key file — keep it outside the repo. NEVER paste the
# private_key into chat / issues / Slack. Rotate immediately if exposed.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Branch Dashboard (Sales Branding + HW sheets)
GOOGLE_BRANCH_DASHBOARD_SHEET_ID=
GOOGLE_BRANCH_HARDWARE_SHEET_ID=

# Neo CRM (Xiaoshouyi) read-only snapshot sync — see lib/external-crm/xiaoshouyi-sync.ts
# Without these, external CRM sync runs are recorded as "skipped" (safe no-op).
# Auth option A: direct service access token
XIAOSHOUYI_BASE_URL=
XIAOSHOUYI_ACCESS_TOKEN=
# Auth option B: service OAuth (password grant) — used when no access token is set
XIAOSHOUYI_CLIENT_ID=
XIAOSHOUYI_CLIENT_SECRET=
XIAOSHOUYI_USERNAME=
XIAOSHOUYI_PASSWORD=
# Optional sync tuning (defaults: all catalog objects, page 100, max 20 pages)
# XIAOSHOUYI_SYNC_OBJECTS=account,contact,opportunity
# XIAOSHOUYI_SYNC_PAGE_SIZE=100
# XIAOSHOUYI_SYNC_MAX_PAGES=20

# Vercel Cron auth — all /api/cron/* routes require "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=replace-with-a-long-random-server-only-secret

# Software checkout — Toss PG
NEXT_PUBLIC_SW_CHECKOUT_ENABLED=false
NEXT_PUBLIC_TOSS_WIDGET_CLIENT_KEY=
TOSS_SECRET_KEY=

# Software checkout — USD plan pricing (defaults match PDF rate sheet)
# Override only if pricing changes. Values are integers (USD cents not used; whole dollars).
NEXT_PUBLIC_BILLING_STANDARD_MONTHLY_USD=99
NEXT_PUBLIC_BILLING_STANDARD_YEARLY_USD=990
NEXT_PUBLIC_BILLING_PLUS_MONTHLY_USD=199
NEXT_PUBLIC_BILLING_PLUS_YEARLY_USD=1990

# FX fallback rates (used when live API is unavailable on cold start)
# Update periodically if rates drift significantly.
USD_KRW_FALLBACK_RATE=1400
CNY_KRW_FALLBACK_RATE=190

# Legacy billing env vars (KRW hardcoded — no longer used, kept for reference only)
# NEXT_PUBLIC_BILLING_STANDARD_MONTHLY_KRW=79000
# NEXT_PUBLIC_BILLING_STANDARD_YEARLY_KRW=790000
# NEXT_PUBLIC_BILLING_PLUS_MONTHLY_KRW=149000
# NEXT_PUBLIC_BILLING_PLUS_YEARLY_KRW=1490000
